---
import Logo3 from "../components/logo3.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Thank you - Hairless</title>
		<meta name="description" content="Bye vello, hola suavidad: Vive la experiencia Hairless en Tijuana. Depilación láser con tecnología de última generación, atención experta y un proceso cómodo y seguro. Di adiós al vello y disfruta una piel suave, sin rituales complicados. Agenda tu cita y empieza tu camino de glow up a una piel libre de vello.">

		<!-- Autor -->
		<meta name="author" content="David Díaz">

        <!-- SEO para Google -->
		<link rel="canonical" href="https://hairlesstj.com/thank-you">

		<!-- Redes Sociales (Open Graph) -->
		<meta property="og:title" content="Thank you - Hairless">
		<meta property="og:description" content="Bye vello, hola suavidad: Vive la experiencia Hairless en Tijuana. Depilación láser con tecnología de última generación, atención experta y un proceso cómodo y seguro. Di adiós al vello y disfruta una piel suave, sin rituales complicados. Agenda tu cita y empieza tu camino de glow up a una piel libre de vello.">
		<meta property="og:image" content="https://hairlesstj.com/hairless-logo.webp">
		<meta property="og:url" content="https://hairlesstj.com">
		<meta property="og:type" content="website">
		
		<!-- Icon Font Stylesheet -->
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
		<!-- Google Web Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
		<!-- Google Web Fonts -->
		<link type="text/css" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Google+Sans:400,500,700|Google+Sans+Text:400,500,700&amp;lang=es">
		<link type="text/css" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Google+Sans+Text:400&amp;text=%E2%86%90%E2%86%92%E2%86%91%E2%86%93&amp;lang=es">
		<!-- Cargar SweetAlert2 desde un CDN -->
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" is:inline defer></script>
	</head>
	<body>
		<a 
			href="https://wa.me/526634375455?text=I%20want%20to%20know%20more" 
			target="_blank"
			class="animate__animated animate__bounce fixed bottom-5 left-5 bg-green-500 text-white w-16 h-16 flex items-center justify-center rounded-full shadow-lg hover:bg-green-600 transition-all duration-300 z-70"
			aria-label="Chat via WhatsApp!">
			<!-- Ícono de WhatsApp -->
			<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-8 h-8" viewBox="0 0 24 24">
				<path d="M12 .5C5.648.5.5 5.648.5 12c0 2.119.557 4.184 1.616 6.006L.5 23.5l5.711-1.566A11.45 11.45 0 0 0 12 23.5c6.352 0 11.5-5.148 11.5-11.5S18.352.5 12 .5Zm0 20.865c-1.867 0-3.691-.5-5.283-1.447l-.378-.223-3.395.931.933-3.309-.246-.381A9.34 9.34 0 0 1 2.635 12c0-5.164 4.201-9.365 9.365-9.365 5.164 0 9.365 4.201 9.365 9.365 0 5.164-4.201 9.365-9.365 9.365Zm5.168-6.991c-.283-.141-1.676-.828-1.935-.922-.259-.095-.448-.141-.638.141-.19.283-.731.922-.896 1.111-.165.19-.331.213-.614.071-.283-.141-1.193-.44-2.271-1.404-.839-.747-1.405-1.669-1.57-1.952-.165-.283-.017-.437.124-.578.128-.128.283-.331.425-.496.141-.165.188-.283.283-.472.095-.19.047-.354-.024-.496-.071-.141-.638-1.542-.874-2.115-.23-.552-.465-.477-.638-.486-.165-.008-.354-.01-.543-.01a1.046 1.046 0 0 0-.755.354c-.259.283-.984.96-.984 2.339 0 1.379 1.008 2.713 1.148 2.903.141.188 1.983 3.027 4.807 4.243.672.289 1.195.461 1.604.59.673.214 1.284.184 1.768.112.539-.08 1.676-.683 1.912-1.342.236-.66.236-1.225.165-1.342-.071-.118-.259-.188-.543-.33Z"/>
			</svg>
		</a>

        <header id="header" class="z-60 fixed top-0 w-full py-6 sm:py-8 px-4 sm:px-8 transition-colors duration-400">
            <div class="flex flex-wrap justify-between items-center">
                <!-- relative block aspect-[370/66] h-[44px] sm:h-[50px] lg:h-[56px] xl:h-[66px] -->
                <a href="/" class="relative block aspect-[370/66] h-[44px] xl:h-[66px]">
                    <Logo3 id="logo3" class="absolute inset-0 transition-all duration-400 opacity-100 scale-100" />
                </a>

                <div class="flex items-center lg:order-2">
                    <!-- Menú de escritorio -->
                    <div class="hidden md:flex items-center lg:order-2 space-x-4">
                        <a class="bg-[#FF8280] rounded-full px-2.5 py-1 text-white hover:text-[#FF8280] hover:bg-[#FFFFFF] duration-300" href="https://www.instagram.com/hairlesstj" target="_blank" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a class="bg-[#FF8280] rounded-full px-3 py-1 text-white hover:text-[#FF8280] hover:bg-[#FFFFFF] duration-300" href="https://www.facebook.com/people/Hairless-Laser/61579279574864/" target="_blank" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://hairlesstj.com/#aboutUs" class="button-header ml-4 font-[Poppins] py-3 px-5 text-sm bg-[#FF8280] text-white rounded-lg cursor-pointer font-semibold text-center shadow-xs transition-all duration-500 hover:text-[#FF8280] hover:bg-[#FFFFFF]">
                            Reservar una cita
                        </a>
                    </div>
                    <button id="btnHeader" data-collapse-toggle="mobile-menu-2" type="button" class="inline-flex items-center p-2 ml-1 text-sm text-white rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 mt-2 sm:mt-0" aria-controls="mobile-menu-2" aria-expanded="false">
                        <span class="sr-only">Open main menu</span>
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
                        <svg class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                    </button>
                </div>
                <div class="lg:hidden justify-between items-center w-full flex order-1 hidden" id="mobilemenu2">
                    <ul class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-8 lg:mt-0 w-full">
                        <li>
                            <a href="https://hairlesstj.com/#home" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 bg-primary-700 lg:bg-transparent lg:text-primary-700 lg:p-0">Home</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#info" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">About us</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#results" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">Results</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#price" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">Price</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#techniques" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">Techniques</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#questions" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">Questions</a>
                        </li>
                        <li>
                            <a href="https://hairlesstj.com/#aboutUs" class="block py-4 pr-4 pl-3 text-white border-b border-gray-100 lg:border-0 lg:p-0">Contact us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
		
		<main class="snap-y snap-mandatory relative w-full h-screen overflow-auto scroll-smooth">
			<section data-header-color="transparent" data-header-logo="3" class="bg-[#f9a9a8] h-screen w-screen relative flex flex-col items-center justify-center px-6 py-8 md:px-12 lg:px-14 xl:px-32 md:py-14 xl:py-24">
                <div class="bg-white relative max-w-lg border border-solid border-gray-200 rounded-2xl p-6 transition-all duration-500 col-span-12 xl:p-7 lg:col-span-3 md:col-span-6 mt-10 xl:mt-20">
                    <div id="questionnaire-container" class="max-w-md mx-auto text-center"></div>
                        <div class="final text-center mt-12">
                            <img class="w-1/2 mx-auto" src="/hmr-thank-you.png" alt="">
                            <h3 data-animation="animate__pulse" class="animate__animated text-2xl md:text-3xl xl:text-4xl font-medium font-[Poppins] my-8 lg:my-12 text-center text-[#FF8280]">Thank you for your registration! We will contact you shortly.</h3>
                        </div>
                    </div>
                </div>
            </section>
		</main>
	</body>
	<!-- Start of winhair Zendesk Widget script -->
	<script 
		id="ze-snippet" 
		src="https://static.zdassets.com/ekr/snippet.js?key=125748b0-2801-409a-91ab-6151644a85a7"
		async 
		defer
		is:inline
		> 
	</script>
	<!-- End of winhair Zendesk Widget script -->
	<script>
        const header = document.querySelector("#header");
        const logo1 = document.querySelector("#logo1");
        const logo2 = document.querySelector("#logo2");
        const btn = document.getElementById("btnHeader");
        const headermobile = document.getElementById("mobilemenu2");

        // 👉 Toggle menú móvil
        btn.addEventListener("click", () => {
            headermobile.classList.toggle("hidden");
            header.classList.toggle("menu-bg");
            header.classList.toggle("shadow-md");
        });

        // 👉 Cerrar menú al hacer click en un link
        const menuLinks = headermobile.querySelectorAll("a");
        menuLinks.forEach(link => {
            link.addEventListener("click", () => {
            headermobile.classList.add("hidden");
            header.classList.remove("menu-bg");
            });
        });
     </script>
</html>
