---
import "../styles/global.css";
---
<section id="aboutUs" 
    data-header-color="transparent" 
    data-header-logo="1" 
    class="bg-white w-screen relative flex justify-center flex-col px-6 pt-4 pb-10 sm:px-10 sm:pt-4 md:pt-14 xl:pt-40 xl:px-16 2xl:px-44">
    <div class="flex flex-col items-center space-y-16">
        <!-- Formulario -->
        <div data-animation="animate__pulse" class="animate__animated flex flex-col w-full items-center">
            <h2 class="text-2xl sm:text-4xl lg:text-4xl xl:text-5xl font-[Poppins] font-light mb-4 xl:mb-10">
                Reserva <b class="text-[#EE7C7E] xl:font-semibold">una cita</b>
            </h2>
            <div class="form-iframe" style="width: 100%; max-width: 800px; margin: 0 auto; padding: 0;">
                <iframe
                    id="hmr-form-iframe"
                    src="https://erp.hmrtijuana.com/iframe-form/eyJpdiI6ImhxODRORU1obDVjR3lLS2Y3Mkx6OUE9PSIsInZhbHVlIjoicUdYblJDZVorTjY2SjR5RjlRTVIvQT09IiwibWFjIjoiMWJmNjJiMzNiMjkzZTcxYjVjNDEwMjgzYjY1OWY1NjE3ZGQ4YmRiYmExN2RlYmFjOGQ0ZDI4M2EyMjk3ZDkzYSIsInRhZyI6IiJ9"
                    frameborder="0"
                    width="100%"
                    height="100%"
                    style="
                    min-height: 800px;
                    width: 100%;
                    border: none;
                    display: block;
                    "
                ></iframe>
            </div>
        </div> 
        <!-- Mapa -->
        <div data-animation="animate__pulse" class="animate__animated hidden md:flex flex-col text-center w-full">
            <h2 class="text-2xl sm:text-4xl lg:text-4xl xl:text-5xl font-[Poppins] font-light mb-4 xl:mb-6">Nuestra <b class="text-[#EE7C7E] xl:font-semibold">ubicación</b></h2>
            <!-- <p class="font-[Poppins] mb-4 xl:mb-6 text-sm xl:text-lg font-light text-gray-800">
                Located only 10 minutes away from the San Ysidro Border Crossing, to make your trip even easier.
            </p>-->
            <div class="w-full h-72 sm:h-96 md:h-full">
                <iframe class="w-full h-96 rounded-lg shadow-md" frameborder="0" scrolling="no" 
                        src="https://maps.google.com/maps?width=500&amp;height=500&amp;hl=en&amp;q=Av. Diego Rivera 2339, Zona Urbana Rio Tijuana, 22010 Tijuana, B.C.&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=B&amp;output=embed">
                </iframe>
            </div>
        </div>
    </div>
</section>